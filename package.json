{
  "name": "cleandrive",
  "version": "0.2.0",
  "description": "Risk-tiered Mac disk cleanup you approve, not a button you regret: clean caches, archive projects to your own drive over SSH with checksum verification, offload big media iCloud-style. Zero dependencies. Built to be driven by Claude Code.",
  "type": "module",
  "bin": { "cleandrive": "bin/cleandrive.js" },
  "files": ["bin/cleandrive.js", "lib/", "ui/", "config.example.json", "docs/offload-strategy.md"],
  "scripts": {
    "scan": "node bin/cleandrive.js scan",
    "serve": "node bin/cleandrive.js serve",
    "state": "node bin/cleandrive.js state",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "node --test test/*.test.mjs"
  },
  "engines": { "node": ">=20" },
  "os": ["darwin"],
  "keywords": ["disk-cleanup", "macos", "disk-space", "cleanup", "rsync", "tailscale", "archive", "offload", "cli", "dashboard", "claude-code", "agent", "zero-dependencies"],
  "author": "Martin Kaiser (https://github.com/kaiser-data)",
  "license": "MIT",
  "homepage": "https://github.com/kaiser-data/cleandrive#readme",
  "repository": { "type": "git", "url": "git+https://github.com/kaiser-data/cleandrive.git" },
  "bugs": { "url": "https://github.com/kaiser-data/cleandrive/issues" }
}
