{
  "name": "mac-cleandrive",
  "version": "0.2.1",
  "description": "Keep a small Mac usable for agentic work: risk-tiered disk cleanup you approve, archive projects to your own drive with checksum verification, offload big media iCloud-style. Zero dependencies, low overhead, built to be driven by Claude Code.",
  "type": "module",
  "bin": { "cleandrive": "bin/cleandrive.js" },
  "files": ["bin/cleandrive.js", "lib/", "ui/", "config.example.json", "docs/offload-strategy.md"],
  "scripts": {
    "scan": "node bin/cleandrive.js scan",
    "serve": "node bin/cleandrive.js serve",
    "state": "node bin/cleandrive.js state",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "node --test test/*.test.mjs"
  },
  "engines": { "node": ">=20" },
  "os": ["darwin"],
  "keywords": ["disk-cleanup", "macos", "disk-space", "cleanup", "rsync", "tailscale", "archive", "offload", "cli", "dashboard", "claude-code", "agent", "zero-dependencies", "low-resource", "apple-silicon", "agentic", "swap"],
  "author": "Martin Kaiser (https://github.com/kaiser-data)",
  "license": "MIT",
  "homepage": "https://github.com/kaiser-data/cleandrive#readme",
  "repository": { "type": "git", "url": "git+https://github.com/kaiser-data/cleandrive.git" },
  "bugs": { "url": "https://github.com/kaiser-data/cleandrive/issues" }
}
